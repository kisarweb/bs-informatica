{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/erp-assistencia/schemas/",
  "title": "PaymentCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amount_cents",
    "method",
    "direction",
    "idempotency_key"
  ],
  "properties": {
    "financial_transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "sale_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "service_order_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "pix",
        "debit_card",
        "credit_card",
        "bank_transfer",
        "boleto",
        "store_credit",
        "other"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ]
    },
    "external_reference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "gateway": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "$comment": "O cliente não pode definir status=confirmed nem paid_at. Confirmação depende de autorização do usuário ou retorno verificado do provedor."
}
