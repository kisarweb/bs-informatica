{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/erp-assistencia/schemas/",
  "title": "EstimateInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_order_id",
    "valid_until",
    "items"
  ],
  "properties": {
    "service_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_type",
          "description",
          "quantity",
          "unit_price_cents"
        ],
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "labor",
              "part",
              "consumable",
              "other"
            ]
          },
          "catalog_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "product_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit_price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "discount_cents": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      }
    }
  },
  "$comment": "Totais e versão são calculados pelo backend. Aprovação deve apontar para uma versão imutável específica."
}
